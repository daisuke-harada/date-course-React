# Google Maps JavaScript API キー（地図表示・経路に使用）
REACT_APP_GOOGLE_MAP_API_KEY=your_google_maps_api_key

# バックエンドAPIのベースURL（Nginx 経由で Rails / Go を切り替える）
REACT_APP_BACKEND_DOMAIN_API=http://localhost:8080/api/v1

# レビュー・評価（星）・人気ランキング UI の表示フラグ
#   実在・実名店（HotPepper 由来）に自作のユーザーレビュー＝第三者評価を
#   公開すると信用毀損・風評のリスクがあるため、本番ではこの変数を設定しない（= 非表示）。
#   ローカルでレビュー機能をデモしたい時だけ true を設定する。
# REACT_APP_ENABLE_REVIEWS=true
